[Unit]
Description=polaris master
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=polaris
Group=polaris
UMask=0077
ExecStart=/usr/local/bin/polaris master serve --config /etc/polaris/master.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
