[Unit]
Description=sb-control agent
After=network-online.target
Wants=network-online.target

[Service]
# Must run as root: the agent writes /etc/sing-box, /etc/nginx/stream-conf.d,
# and /etc/fail2ban on behalf of the master, and restarts sing-box.service /
# nginx.service via systemctl.
User=root
ExecStart=/usr/local/bin/sb-control agent run --data-dir /var/lib/sb-control-agent --master MASTER_HOST:8443 --master-pubkey MASTER_NOISE_PUBKEY --sing-box-version 1.12.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
