[Unit]
Description=polaris agent
After=network-online.target
Wants=network-online.target

[Service]
# Must run as root: the agent writes /etc/sing-box, /etc/nginx/stream-conf.d,
# and /etc/fail2ban on behalf of the master, and restarts sing-box.service /
# nginx.service via systemctl.
User=root
ExecStart=/usr/local/bin/polaris agent serve --config /etc/polaris/agent.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
