[Unit]
Description=polaris agent
After=network-online.target
Wants=network-online.target

[Service]
# Must run as root: the agent writes /etc/sing-box, /etc/nginx/stream-conf.d,
# and /etc/fail2ban on behalf of the master, and restarts sing-box.service /
# nginx.service via systemctl.
User=root
ExecStart=/usr/local/bin/polaris agent serve --config /etc/polaris/agent.yaml
Restart=on-failure
RestartSec=5

# CPU & I/O priority isolation: agent yields CPU and disk during network forwarding
Nice=19
CPUWeight=50
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Memory limits & OOM protection: agent sacrifices before proxy
MemoryHigh=150M
MemoryMax=250M
OOMScoreAdjust=500

# Go runtime resource constraints for low-spec / 512M nodes
Environment="GOMEMLIMIT=120MiB"
Environment="GOGC=50"
Environment="GODEBUG=madvdontneed=1"
Environment="GOMAXPROCS=1"
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
